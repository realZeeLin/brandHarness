{
  "name": "brandharness",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "brandharness",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@brandharness/brand-cli": {
      "resolved": "packages/brand-cli",
      "link": true
    },
    "node_modules/@brandharness/brand-core": {
      "resolved": "packages/brand-core",
      "link": true
    },
    "node_modules/@brandharness/brand-mcp": {
      "resolved": "packages/brand-mcp",
      "link": true
    },
    "node_modules/@brandharness/brand-server": {
      "resolved": "packages/brand-server",
      "link": true
    },
    "node_modules/dsh-plugin-brand-insight": {
      "resolved": "packages/dsh-plugin-brand-insight",
      "link": true
    },
    "packages/brand-cli": {
      "name": "@brandharness/brand-cli",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@brandharness/brand-core": "file:../brand-core"
      },
      "bin": {
        "brand": "src/cli.js"
      }
    },
    "packages/brand-core": {
      "name": "@brandharness/brand-core",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/brand-mcp": {
      "name": "@brandharness/brand-mcp",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@brandharness/brand-core": "file:../brand-core"
      },
      "bin": {
        "brand-mcp": "src/server.js"
      }
    },
    "packages/brand-server": {
      "name": "@brandharness/brand-server",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@brandharness/brand-core": "file:../brand-core"
      },
      "bin": {
        "brand-server": "src/server.js"
      }
    },
    "packages/dsh-plugin-brand-insight": {
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@brandharness/brand-core": "file:../brand-core"
      },
      "engines": {
        "dsh": ">=0.2.0-rc.1 <0.3.0",
        "node": ">=24.9.0"
      },
      "peerDependencies": {
        "@deepseek-ai/dsh-tools": "*",
        "@deepseek-ai/schemastery": "*"
      },
      "peerDependenciesMeta": {
        "@deepseek-ai/dsh-tools": {
          "optional": true
        },
        "@deepseek-ai/schemastery": {
          "optional": true
        }
      }
    }
  }
}
